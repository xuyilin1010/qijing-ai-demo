{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "canvas": {
        "top": { "$type": "color", "$value": "#f4f2ec", "$extensions": { "cssName": "--bg-top" } },
        "bottom": { "$type": "color", "$value": "#ece9e1", "$extensions": { "cssName": "--bg-bot" } }
      },
      "card": { "$type": "color", "$value": "#fbf9f4", "$extensions": { "cssName": "--card" } },
      "cardAlt": { "$type": "color", "$value": "#f6f3ec", "$extensions": { "cssName": "--card-2" } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#262320", "$extensions": { "cssName": "--ink" } },
      "secondary": { "$type": "color", "$value": "#595650", "$extensions": { "cssName": "--ink2" } },
      "muted": { "$type": "color", "$value": "#6d685f", "$extensions": { "cssName": "--ink3" } },
      "faint": { "$type": "color", "$value": "#b8b3a9", "$extensions": { "cssName": "--ink4" } },
      "night": { "$type": "color", "$value": "#eef0fb", "$extensions": { "cssName": "--night-ink" } },
      "nightMuted": { "$type": "color", "$value": "#aab0d4", "$extensions": { "cssName": "--night-ink2" } },
      "onGold": { "$type": "color", "$value": "#22182a", "$extensions": { "cssName": "--on-gold" } },
      "onNavyWarm": { "$type": "color", "$value": "#f1e4c4", "$extensions": { "cssName": "--on-navy-warm" } }
    },
    "brand": {
      "navy": { "$type": "color", "$value": "#1c2046", "$extensions": { "cssName": "--navy" } },
      "navy2": { "$type": "color", "$value": "#2a3060", "$extensions": { "cssName": "--navy-2" } },
      "navyDeep": { "$type": "color", "$value": "#181c40", "$extensions": { "cssName": "--navy-deep" } },
      "gold": { "$type": "color", "$value": "#bb8a36", "$extensions": { "cssName": "--gold" } },
      "gold2": { "$type": "color", "$value": "#d6a347", "$extensions": { "cssName": "--gold-2" } },
      "goldDeep": { "$type": "color", "$value": "#9c722a", "$extensions": { "cssName": "--gold-deep" } },
      "goldOnNavy": { "$type": "color", "$value": "#e7c878", "$extensions": { "cssName": "--gold-on-navy" } }
    },
    "semantic": {
      "ok": { "$type": "color", "$value": "#3a7350", "$extensions": { "cssName": "--ok" } },
      "warn": { "$type": "color", "$value": "#b06a26", "$extensions": { "cssName": "--warn" } },
      "err": { "$type": "color", "$value": "#a64f48", "$extensions": { "cssName": "--err" } }
    }
  },
  "alphaColor": {
    "line": { "$type": "color", "$value": "rgba(32,37,74,.085)", "$extensions": { "cssName": "--line" } },
    "lineStrong": { "$type": "color", "$value": "rgba(32,37,74,.14)", "$extensions": { "cssName": "--line2" } },
    "goldSoft": { "$type": "color", "$value": "rgba(187,138,54,.12)", "$extensions": { "cssName": "--gold-soft" } },
    "goldSoft2": { "$type": "color", "$value": "rgba(187,138,54,.18)", "$extensions": { "cssName": "--gold-soft2" } },
    "goldLine": { "$type": "color", "$value": "rgba(187,138,54,.4)", "$extensions": { "cssName": "--gold-line" } },
    "okSoft": { "$type": "color", "$value": "rgba(58,115,80,.13)", "$extensions": { "cssName": "--ok-soft" } },
    "warnSoft": { "$type": "color", "$value": "rgba(176,106,38,.14)", "$extensions": { "cssName": "--warn-soft" } },
    "errSoft": { "$type": "color", "$value": "rgba(166,79,72,.13)", "$extensions": { "cssName": "--err-soft" } }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "\"Geist\",\"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif", "$extensions": { "cssName": "--sans" } },
      "serif": { "$type": "fontFamily", "$value": "\"Source Serif 4\",\"Noto Serif SC\",Georgia,\"Songti SC\",serif", "$extensions": { "cssName": "--serif" } },
      "mono": { "$type": "fontFamily", "$value": "\"Geist Mono\",\"SF Mono\",ui-monospace,Menlo,monospace", "$extensions": { "cssName": "--mono" } }
    },
    "fontSize": {
      "meta": { "$type": "dimension", "$value": "12px", "$extensions": { "cssName": "--type-meta" } },
      "body": { "$type": "dimension", "$value": "14px", "$extensions": { "cssName": "--type-body" } },
      "cardTitle": { "$type": "dimension", "$value": "16px", "$extensions": { "cssName": "--type-card-title" } },
      "zoneTitle": { "$type": "dimension", "$value": "20px", "$extensions": { "cssName": "--type-zone-title" } },
      "pageTitle": { "$type": "dimension", "$value": "26px", "$extensions": { "cssName": "--type-page-title" } },
      "metric": { "$type": "dimension", "$value": "34px", "$extensions": { "cssName": "--type-metric" } }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": "400", "$extensions": { "cssName": "--weight-regular" } },
      "semibold": { "$type": "fontWeight", "$value": "600", "$extensions": { "cssName": "--weight-semibold" } }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "8px", "$extensions": { "cssName": "--space-1" } },
    "2": { "$type": "dimension", "$value": "16px", "$extensions": { "cssName": "--space-2" } },
    "3": { "$type": "dimension", "$value": "24px", "$extensions": { "cssName": "--space-3" } },
    "4": { "$type": "dimension", "$value": "32px", "$extensions": { "cssName": "--space-4" } },
    "5": { "$type": "dimension", "$value": "40px", "$extensions": { "cssName": "--space-5" } },
    "6": { "$type": "dimension", "$value": "48px", "$extensions": { "cssName": "--space-6" } },
    "section": { "$type": "dimension", "$value": "56px", "$extensions": { "cssName": "--space-section" } },
    "8": { "$type": "dimension", "$value": "64px", "$extensions": { "cssName": "--space-8" } },
    "pageBottom": { "$type": "dimension", "$value": "96px", "$extensions": { "cssName": "--space-page-b" } }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "7px", "$extensions": { "cssName": "--radius-xs" } },
    "sm": { "$type": "dimension", "$value": "10px", "$extensions": { "cssName": "--radius-sm" } },
    "md": { "$type": "dimension", "$value": "12px", "$extensions": { "cssName": "--radius-md" } },
    "lg": { "$type": "dimension", "$value": "14px", "$extensions": { "cssName": "--radius-lg" } },
    "xl": { "$type": "dimension", "$value": "18px", "$extensions": { "cssName": "--radius-xl" } },
    "full": { "$type": "dimension", "$value": "999px", "$extensions": { "cssName": "--radius-full" } }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgba(32,37,74,.05),0 1px 0 rgba(32,37,74,.03)", "$extensions": { "cssName": "--shadow-1" } },
    "2": { "$type": "shadow", "$value": "0 2px 5px rgba(32,37,74,.06),0 14px 34px rgba(32,37,74,.08)", "$extensions": { "cssName": "--shadow-2" } },
    "logo": { "$type": "shadow", "$value": "0 3px 8px rgba(28,32,70,.26)", "$extensions": { "cssName": "--shadow-logo" } },
    "ring": { "$type": "shadow", "$value": "0 0 0 3px rgba(187,138,54,.12)", "$extensions": { "cssName": "--ring" } }
  },
  "gradient": {
    "gold": { "$type": "custom-gradient", "$value": "linear-gradient(150deg,#e9bf5f,#cf9a3b)", "$extensions": { "cssName": "--grad-gold" } },
    "navy": { "$type": "custom-gradient", "$value": "linear-gradient(150deg,#2a3060,#181c40)", "$extensions": { "cssName": "--grad-navy" } },
    "green": { "$type": "custom-gradient", "$value": "linear-gradient(150deg,#3a6b52,#21402f)", "$extensions": { "cssName": "--grad-green" } },
    "plum": { "$type": "custom-gradient", "$value": "linear-gradient(150deg,#7d5a86,#432f50)", "$extensions": { "cssName": "--grad-plum" } },
    "bar": { "$type": "custom-gradient", "$value": "linear-gradient(180deg,rgba(244,242,236,.9),rgba(244,242,236,.6))", "$extensions": { "cssName": "--bar-bg" } }
  },
  "asset": {
    "grain": {
      "$type": "asset",
      "$value": "url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"160\"><filter id=\"g\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.85\" numOctaves=\"2\" stitchTiles=\"stitch\"/><feColorMatrix type=\"saturate\" values=\"0\"/></filter><rect width=\"160\" height=\"160\" filter=\"url(%23g)\"/></svg>')",
      "$extensions": { "cssName": "--grain" }
    }
  }
}
